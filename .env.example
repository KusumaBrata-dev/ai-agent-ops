# Copy ke .env dan isi. JANGAN commit .env ke git.
# LLM OpenAI-compatible (default: OpenRouter — punya model :free)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
MODEL_NAME=gemini/gemini-2.0-flash-exp:free

# =1 untuk jalan tanpa LLM (demo offline / CI / spek kentang)
MOCK_LLM=1

# DB (kosong = pakai SQLite ./agent.db; prod: postgresql://...)
DATABASE_URL=

# Agen
AGENT_INTERVAL_SEC=30
AGENT_ENABLED=1

# Google Sheets (Fase 2.4): publish sheet sebagai CSV, tempel URL di sini
SHEETS_CSV_URL=

# Telegram (Fase 2.3): token dari @BotFather. Kosong = notifikasi off (web UI tetap jalan)
TELEGRAM_BOT_TOKEN=
# Host publik saat deploy (untuk tombol callback); kosong saat dev lokal
TELEGRAM_WEBHOOK_URL=
